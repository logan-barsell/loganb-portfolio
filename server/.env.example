NODE_ENV=development
HOST=127.0.0.1
PORT=3001

DATABASE_PATH=./data/inquiries.sqlite
UPLOAD_PATH=./data/uploads

RESEND_API_KEY=re_your_private_key
RESEND_FROM="Logan Barsell Web Services <website@mail.loganbarsell.com>"
INQUIRY_NOTIFY_TO=contact@loganbarsell.com

# Set to 1 behind nginx so rate limiting sees the real client IP
TRUST_PROXY=0

# Admin portal (required in production). Generate hash with: npm run hash-password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace_with_npm_run_hash_password
ADMIN_SESSION_SECRET=replace_with_long_random_string_at_least_32_chars
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_SESSION_COOKIE_NAME=lb_admin_session
ALLOWED_ORIGIN=http://localhost:3000
# Public site origin used in client proposal share + project portal links
PUBLIC_APP_URL=http://localhost:3000
# Optional logo override. If unset: production uses PUBLIC_APP_URL/email-logo.png;
# localhost falls back to https://loganbarsell.com/email-logo.png (email clients can't load local images).
# EMAIL_LOGO_URL=https://loganbarsell.com/email-logo.png

# Client account and project portal sessions (required in production)
CLIENT_SESSION_SECRET=replace_with_another_long_random_string_at_least_32_chars
CLIENT_SESSION_TTL_SECONDS=604800
CLIENT_SESSION_COOKIE_NAME=lb_client_session
CLIENT_PORTAL_SETUP_TTL_DAYS=7
CLIENT_PASSWORD_RESET_TTL_MINUTES=60

# Stripe (optional in local; required for live Checkout / webhooks)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
# Pre-created Price IDs for hosting catalog (must be real price_… IDs in production)
STRIPE_HOSTING_PRICE_ID_39=price_temp_hosting_39
STRIPE_HOSTING_PRICE_ID_25=price_temp_hosting_25
STRIPE_HOSTING_PRICE_ID_10=price_temp_hosting_10
# Client hosting droplet (optional). Provision Site is disabled until SSH host + public IP are set.
# Do not put the private key in this file — path only. See docs/HOSTING.md.
# CLIENT_HOSTING_SSH_HOST=10.x.x.x
# CLIENT_HOSTING_PUBLIC_IP=203.0.113.10
# CLIENT_HOSTING_SSH_USER=site-provision
# CLIENT_HOSTING_SSH_KEY_PATH=/etc/loganb-api/client-host.key
# CLIENT_HOSTING_SSH_PORT=22
# CLIENT_HOSTING_KNOWN_HOSTS_PATH=/var/lib/loganb-api/ssh/known_hosts

# Local: stripe listen --forward-to localhost:3001/api/stripe/webhook
# Dashboard Customer Portal: enable cancel + switch among the three hosting prices
# Prod webhook events: checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed, checkout.session.expired
